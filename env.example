# Booking form email delivery via Resend (see app/api/lead/route.ts + lib/email.ts).
# Every submission sends two emails: a lead notification to you, and a
# confirmation to the person who filled out the form.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# Where lead notifications land. Comma-separate for multiple recipients.
LEAD_TO_EMAIL=you@sagesummitcapital.com

# The "From" line on both emails. Must be on a domain verified in Resend.
# Defaults to onboarding@resend.dev, which only delivers to your own Resend
# account email — fine for testing, not for production.
LEAD_FROM_EMAIL="Sage Summit Capital <leads@sagesummitcapital.com>"

# Optional, for canonical URLs:
# NEXT_PUBLIC_SITE_URL=https://sagesummitcapital.com
